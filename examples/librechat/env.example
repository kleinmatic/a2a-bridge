# LibreChat environment for the example stack.
# `make demo-config` copies this to .env and fills the four secrets below.

#─ Server ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3080

#─ Secrets ─────────────────────────────────────────────────────────────────────
# LibreChat will not start without these. They are durable per-deployment
# identity, not per-run values: changing them invalidates existing sessions and
# makes anything already encrypted with them unreadable. Generate once, keep.
#
#   CREDS_KEY / JWT secrets: openssl rand -hex 32
#   CREDS_IV:                openssl rand -hex 16
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

#─ The bridge ──────────────────────────────────────────────────────────────────
# Shared between the bridge (A2A_BRIDGE_API_KEYS) and librechat.yaml's apiKey.
# Not a credential for anything upstream — it only stops other processes on this
# host from using the bridge.
A2A_BRIDGE_API_KEY=demo-key
A2A_BRIDGE_LOG_LEVEL=INFO

#─ Accounts ────────────────────────────────────────────────────────────────────
# First visit registers an account. Local-only demo, so email verification is off.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

#─ Trimmed services ────────────────────────────────────────────────────────────
# The compose file omits Meilisearch, pgvector and the RAG API. Leaving search
# enabled makes LibreChat log connection errors for a service that is not there.
SEARCH=false
