data: {"id":"fixture-stream-1","jsonrpc":"2.0","result":{"artifact":{"artifactId":"2eb9b4da-e5ce-47cd-bee5-049e5ea0a11c","name":"result","parts":[{"kind":"text","text":"[THE RIDGELINE GAZETTE]\n\nI'm The Ridgeline Gazette — I only help with Ridgeline public schools: school data, comparisons, admissions and attendance zones, and booking school tours. I can't help with that request. Ask me about a school, a neighborhood, or an address and I'll dig in."}]},"contextId":"add52e31-47e6-4f97-9455-aeaf468577db","kind":"artifact-update","taskId":"36194c38-4832-4df6-9ef8-f5a53a8e8220"}}

